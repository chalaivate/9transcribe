<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The pill is always dark, whatever the app theme: it has to stay readable on top of any
       wallpaper or document. It is a layered, click-through window, so real system blur is
       not available; the glass look is a translucent gradient, a bright rim along the top
       edge and a soft shadow underneath. -->

  <LinearGradientBrush x:Key="PillGlassBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D8242438" Offset="0" />
    <GradientStop Color="#E8101018" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PillErrorGlassBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#DC4A1626" Offset="0" />
    <GradientStop Color="#EA200A10" Offset="1" />
  </LinearGradientBrush>

  <!-- Brightest in the middle and gone at the ends, like light catching a curved edge. -->
  <LinearGradientBrush x:Key="RimHighlightBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00FFFFFF" Offset="0" />
    <GradientStop Color="#40FFFFFF" Offset="0.5" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Static version of the ring colours, for the spinner stroke and the record dot. -->
  <LinearGradientBrush x:Key="AccentStaticBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF7C3AED" Offset="0" />
    <GradientStop Color="#FFEC4899" Offset="0.5" />
    <GradientStop Color="#FFF97316" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="RecordDotBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFEC4899" Offset="0" />
    <GradientStop Color="#FFF97316" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PillForeground" Color="#F5FFFFFF" />
  <SolidColorBrush x:Key="PillForegroundDim" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="WaveBarBrush" Color="#E0FFFFFF" />
  <SolidColorBrush x:Key="NoticeGlyphBrush" Color="#FF60A5FA" />
  <SolidColorBrush x:Key="ErrorGlyphBrush" Color="#FFF87171" />

</ResourceDictionary>
