<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The status tab is always dark, whatever the app theme: it has to stay readable on top of
       any wallpaper or document. It is a layered, click-through window, so real system blur is
       not available; the glass look is a translucent gradient, a faint edge, a bright rim along
       the top and a soft shadow underneath. The transcript above it takes its colours from the
       user's settings instead. -->

  <LinearGradientBrush x:Key="PillGlassBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#7A1A1A2A" Offset="0" />
    <GradientStop Color="#A80C0C14" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PillErrorGlassBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#9A4A1626" Offset="0" />
    <GradientStop Color="#BE200A10" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PillEdgeBrush" Color="#38FFFFFF" />

  <!-- Brightest in the middle and gone at the ends, like light catching a curved edge. -->
  <LinearGradientBrush x:Key="RimHighlightBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00FFFFFF" Offset="0" />
    <GradientStop Color="#48FFFFFF" Offset="0.5" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- The brand gradient, for the spinner, the main wave and the "done" badge. -->
  <LinearGradientBrush x:Key="AccentStaticBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF7C3AED" Offset="0" />
    <GradientStop Color="#FFEC4899" Offset="0.5" />
    <GradientStop Color="#FFF97316" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="WaveSecondaryBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FFEC4899" Offset="0" />
    <GradientStop Color="#FFF97316" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="WaveTertiaryBrush" Color="#FFFFFFFF" />

  <!-- The recording dot is plain red: it is the one universally understood signal. -->
  <LinearGradientBrush x:Key="RecordDotBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFF3B30" Offset="0" />
    <GradientStop Color="#FFFF6A5C" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PillForeground" Color="#F5FFFFFF" />
  <SolidColorBrush x:Key="PillForegroundDim" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="NoticeGlyphBrush" Color="#FF60A5FA" />
  <SolidColorBrush x:Key="ErrorGlyphBrush" Color="#FFF87171" />

</ResourceDictionary>
