<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>9Transcribe</AssemblyName>
    <RootNamespace>NineTranscribe</RootNamespace>
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Publish-time only; see .github/workflows/build.yml for the publish commands.
         RuntimeIdentifier/SelfContained deliberately live on the command line so the test
         project can still reference this one (NETSDK1150). Single-file compression stays off:
         it unpacks every assembly into private memory at start-up, which measured as ~80 MB
         of extra RAM for a smaller file on disk. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- A tray app with a small heap: a background GC thread and dynamic PGO instrumentation
         cost memory for no visible benefit. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 2.4.x ships net10.0-windows and net462 builds only, which is why the .NET 8 version
         of this app had to stay on 2.3.0. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="9Transcribe.Tests" />
  </ItemGroup>

</Project>
