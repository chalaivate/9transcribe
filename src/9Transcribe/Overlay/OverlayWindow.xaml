<Window x:Class="NineTranscribe.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        FontFamily="Leelawadee UI, Segoe UI">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Overlay.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- Two stacked parts. The transcript ends on the guide line and the tab hangs below it;
       the positioner is told how tall the top part is so the line lands between them. The
       margin is room for the shadow to bleed into and for the entrance rise; the transform
       is the entrance. -->
  <Grid x:Name="Root" Margin="16,12,16,16" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="EntranceScale" ScaleX="1" ScaleY="1" />
        <TranslateTransform x:Name="EntranceSlide" X="0" Y="0" />
      </TransformGroup>
    </Grid.RenderTransform>

    <StackPanel HorizontalAlignment="Center">

      <!-- Transcribed text, above the line. Colours, size and background come from settings
           through ApplyStyle. The bitmap cache keeps the readability halo (an effect) from
           being re-rendered while the waveform below animates. LineHeight is mandatory for
           Thai: tone marks stack above upper vowels and are clipped at the default height. -->
      <Border CacheMode="BitmapCache">
        <Border x:Name="TranscriptPanel" CornerRadius="12" Padding="16,8" Margin="0,0,0,12"
                HorizontalAlignment="Center" Background="Transparent" Visibility="Collapsed">
          <TextBlock x:Name="TranscriptText"
                     FontSize="28"
                     LineHeight="45"
                     LineStackingStrategy="BlockLineHeight"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     MaxHeight="190" />
        </Border>
      </Border>

      <!-- The status tab, below the line. -->
      <Grid HorizontalAlignment="Center">

        <!-- The shadow is cast by an empty sibling inside a bitmap cache: the blur is
             rasterised once per size, not on every frame the waveform moves. -->
        <Border CacheMode="BitmapCache">
          <Border x:Name="Shadow" CornerRadius="24" Background="#B0101018">
            <Border.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#FF000000" />
            </Border.Effect>
          </Border>
        </Border>

        <!-- Gradient ring; the brush is built in code so its rotation can be animated. -->
        <Border x:Name="Ring" CornerRadius="24" BorderThickness="1.5" Background="Transparent">
          <Border x:Name="Pill" CornerRadius="22.5" Background="{StaticResource PillGlassBrush}">
            <Border CornerRadius="22.5" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource RimHighlightBrush}" Padding="18,10">
              <Grid>

                <!-- Listening: [red dot] [waveform] [elapsed] -->
                <StackPanel x:Name="ListeningPanel" Orientation="Horizontal" Visibility="Collapsed">
                  <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <Ellipse x:Name="RecordHalo" Fill="{StaticResource RecordDotBrush}" Opacity="0.35"
                             RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="RecordHaloScale" ScaleX="1" ScaleY="1" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="RecordDotShape" Width="10" Height="10"
                             Fill="{StaticResource RecordDotBrush}"
                             RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="RecordDotScale" ScaleX="1" ScaleY="1" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                  </Grid>

                  <!-- Fixed size on purpose: the curves move thirty times a second, and a panel
                       that grew with them would re-measure the window on every tick. -->
                  <Canvas x:Name="Waveform" Width="150" Height="30" Margin="16,0"
                          VerticalAlignment="Center" ClipToBounds="False" />

                  <TextBlock x:Name="ElapsedText" Text="0:00"
                             FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                             MinWidth="42" TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{StaticResource PillForeground}" />
                </StackPanel>

                <!-- Transcribing -->
                <StackPanel x:Name="ProcessingPanel" Orientation="Horizontal" Visibility="Collapsed">
                  <Path x:Name="Spinner" Width="18" Height="18"
                        Stroke="{StaticResource AccentStaticBrush}" StrokeThickness="2.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 9,1.5 A 7.5,7.5 0 1 1 1.5,9"
                        RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                    <Path.RenderTransform>
                      <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                    </Path.RenderTransform>
                  </Path>
                  <TextBlock x:Name="ProcessingText" Margin="12,0,0,0" FontSize="14"
                             LineHeight="22" LineStackingStrategy="BlockLineHeight"
                             Foreground="{StaticResource PillForeground}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Pasted -->
                <StackPanel x:Name="DonePanel" Orientation="Horizontal" Visibility="Collapsed">
                  <Border Width="20" Height="20" CornerRadius="10"
                          Background="{StaticResource AccentStaticBrush}" VerticalAlignment="Center">
                    <Path Data="M 5.5,10.5 L 8.5,13.5 L 14.5,7" Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Border>
                  <TextBlock x:Name="DoneText" Margin="12,0,0,0" FontSize="14"
                             LineHeight="22" LineStackingStrategy="BlockLineHeight"
                             Foreground="{StaticResource PillForeground}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Error and notice -->
                <StackPanel x:Name="MessagePanel" Orientation="Horizontal" Visibility="Collapsed">
                  <Border x:Name="MessageBadge" Width="22" Height="22" CornerRadius="11"
                          Background="{StaticResource NoticeGlyphBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageGlyph" Text="!" FontSize="14" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="MessageText" Margin="12,0,0,0" FontSize="13" MaxWidth="520"
                             TextWrapping="Wrap" LineHeight="22" LineStackingStrategy="BlockLineHeight"
                             Foreground="{StaticResource PillForeground}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
          </Border>
        </Border>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
